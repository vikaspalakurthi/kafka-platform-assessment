---
# Matches what ansible-lint expects, with a longer line limit.
extends: default
rules:
  line-length:
    max: 120
  comments:
    min-spaces-from-content: 2
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  truthy:
    check-keys: false
