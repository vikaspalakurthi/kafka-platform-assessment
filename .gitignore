# This repo is public. Secrets stay out of it, whichever section they come from.
# Terraform state and tfvars are covered by terraform/.gitignore.

# Environment files and private keys
.env
.env.*
*.pem
*.key

# API key files downloaded from the Confluent Cloud console
api-key*.txt

# Ansible Vault password files
.vault_pass*
vault_pass*
!.env.example

# Working files that are not part of the submission
assignment.txt

# Client keystores and connection files
*.p12
*.jks
client.properties

# Generated by tools
.ansible/
*.retry
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.sarif

# Local editor and assistant settings
.claude/
.vscode/
.idea/
